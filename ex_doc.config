{main, <<"readme">>}.
{proglang, erlang}.
{warnings_as_errors, true}.
{extras, [
    <<"README.md">>,
    <<"guides/hash-and-xof.md">>,
    <<"guides/migrating-to-3.0.md">>,
    <<"guides/development.md">>,
    <<"CHANGELOG.md">>,
    <<"LICENSE.md">>
]}.
{source_url, <<"https://github.com/potatosalad/erlang-libdecaf">>}.
{source_ref, <<"3.0.0">>}.
{source_url_pattern, <<"https://github.com/potatosalad/erlang-libdecaf/blob/3.0.0/%{path}#L%{line}">>}.
{groups_for_modules, [
    {<<"Public API">>, [libdecaf]},
    {<<"Curves and groups">>, [libdecaf_curve25519, libdecaf_curve448, libdecaf_ristretto255, libdecaf_decaf448]},
    {<<"Specialized APIs">>, [libdecaf_tuak, libdecaf_spongerng]},
    {<<"Native API">>, [libdecaf_nif]},
    {<<"Compatibility">>, [libdecaf_sha2, libdecaf_sha3, libdecaf_keccak_sha3]}
]}.
