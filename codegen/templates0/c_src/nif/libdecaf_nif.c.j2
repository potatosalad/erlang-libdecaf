static int libdecaf_nif_load(ErlNifEnv *env, void **priv_data, ERL_NIF_TERM load_info);
static int libdecaf_nif_upgrade(ErlNifEnv *env, void **new_priv_data, void **old_priv_data, ERL_NIF_TERM load_info);
static void libdecaf_nif_unload(ErlNifEnv *env, void *priv_data);

static int
libdecaf_nif_load(ErlNifEnv *env, void **priv_data, ERL_NIF_TERM load_info)
{
    (void)priv_data;
    (void)load_info;
    /* Load Resource Types */
    if (libdecaf_nif_csprng_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed25519_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed25519ph_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed448_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed448ph_load(env) != 0)
        return -1;
    if (libdecaf_nif_hash_load(env) != 0)
        return -1;
    if (libdecaf_nif_xof_load(env) != 0)
        return -1;
{% for family in ctx.crypto_families if family.name in ('kt', 'hopmac') %}
    if ({{ family.prefix }}_load(env) != 0)
        return -1;
{% endfor %}
{% for group in ctx.prime_order_groups %}
    if (libdecaf_nif_{{ group.name }}_load(env) != 0)
        return -1;
{% endfor %}
    /* Initialize common atoms */
    (void)libdecaf_nif_make_atoms(env);
    return libdecaf_nif_parallel_load(env, priv_data, NULL);
}

static int
libdecaf_nif_upgrade(ErlNifEnv *env, void **new_priv_data, void **old_priv_data, ERL_NIF_TERM load_info)
{
    (void)old_priv_data;
    (void)load_info;
    /* Upgrade Resource Types */
    if (libdecaf_nif_csprng_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed25519_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed25519ph_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed448_load(env) != 0)
        return -1;
    if (libdecaf_nif_ed448ph_load(env) != 0)
        return -1;
    if (libdecaf_nif_hash_load(env) != 0)
        return -1;
    if (libdecaf_nif_xof_load(env) != 0)
        return -1;
{% for family in ctx.crypto_families if family.name in ('kt', 'hopmac') %}
    if ({{ family.prefix }}_load(env) != 0)
        return -1;
{% endfor %}
{% for group in ctx.prime_order_groups %}
    if (libdecaf_nif_{{ group.name }}_load(env) != 0)
        return -1;
{% endfor %}
    /* Initialize common atoms */
    (void)libdecaf_nif_make_atoms(env);
    return libdecaf_nif_parallel_load(env, new_priv_data, *old_priv_data);
}

static void
libdecaf_nif_unload(ErlNifEnv *env, void *priv_data)
{
    (void)env;
    libdecaf_nif_parallel_unload(priv_data);
    return;
}

ERL_NIF_INIT(libdecaf_nif, libdecaf_nif_funcs, libdecaf_nif_load, NULL, libdecaf_nif_upgrade, libdecaf_nif_unload);
