#include "tuak.h"
#include "tuak_primitive.h"
#include <decaf/common.h>
#include <stdbool.h>

/* Each operation lists its accepted options; unrelated keys are rejected. */
typedef struct {
    ERL_NIF_TERM key;
    unsigned *value;
    const unsigned *lengths;
    size_t length_count;
} libdecaf_nif_tuak_option_t;

{% for option in ctx.tuak_options if option.lengths %}
static const unsigned libdecaf_nif_tuak_{{ option.name }}s[] = { {{ option.lengths | join(', ') }} };
{% endfor %}

static bool
libdecaf_nif_tuak_options(ErlNifEnv *env, ERL_NIF_TERM term, const libdecaf_nif_tuak_option_t *accepted, size_t count)
{
    size_t size, found = 0;
    if (!enif_get_map_size(env, term, &size))
        return false;
    for (size_t i = 0; i < count; ++i) {
        ERL_NIF_TERM value;
        if (!enif_get_map_value(env, term, accepted[i].key, &value))
            continue;
        unsigned number;
        if (!enif_get_uint(env, value, &number) || number == 0)
            return false;
        if (accepted[i].length_count != 0) {
            size_t j = 0;
            while (j < accepted[i].length_count && accepted[i].lengths[j] != number)
                ++j;
            if (j == accepted[i].length_count)
                return false;
        }
        *accepted[i].value = number;
        ++found;
    }
    return found == size;
}

enum { LIBDECAF_NIF_TUAK_PERMUTATIONS_PER_CALL = 512 };

/* A continuation owns only fixed-size state, never Erlang input pointers. */
typedef struct {
    uint8_t state[200];
    libdecaf_nif_tuak_options_t options;
    ERL_NIF_TERM operation;
    uint32_t remaining;
} libdecaf_nif_tuak_trap_t;

static ErlNifResourceType *libdecaf_nif_tuak_resource_type;

static void
libdecaf_nif_tuak_dtor(ErlNifEnv *env, void *object)
{
    (void)env;
    decaf_bzero(object, enif_sizeof_resource(object));
}

int
libdecaf_nif_tuak_load(ErlNifEnv *env)
{
    libdecaf_nif_tuak_resource_type = enif_open_resource_type(env, "libdecaf_nif", "tuak_evaluation",
        libdecaf_nif_tuak_dtor, ERL_NIF_RT_CREATE | ERL_NIF_RT_TAKEOVER, NULL);
    return libdecaf_nif_tuak_resource_type != NULL ? 0 : -1;
}

static ERL_NIF_TERM
libdecaf_nif_tuak_finish(ErlNifEnv *env, const libdecaf_nif_tuak_trap_t *trap)
{
    const libdecaf_nif_tuak_options_t options = trap->options;
{% for operation in ctx.tuak_operations %}
    if (trap->operation == ATOM(tuak_{{ operation.name }})) {
{% if operation.name == 'f2345' %}
        ERL_NIF_TERM res_term, ck_term, ik_term, ak_term;
        uint8_t *res = enif_make_new_binary(env, options.res_length, &res_term);
        uint8_t *ck = enif_make_new_binary(env, options.ck_length, &ck_term);
        uint8_t *ik = enif_make_new_binary(env, options.ik_length, &ik_term);
        uint8_t *ak = enif_make_new_binary(env, 6, &ak_term);
        if (res == NULL || ck == NULL || ik == NULL || ak == NULL)
            return EXCP_ERROR(env, "Cannot allocate TUAK outputs");
        libdecaf_nif_tuak_extract(trap->state, 0, res, options.res_length);
        libdecaf_nif_tuak_extract(trap->state, 32, ck, options.ck_length);
        libdecaf_nif_tuak_extract(trap->state, 64, ik, options.ik_length);
        libdecaf_nif_tuak_extract(trap->state, 96, ak, 6);
        return enif_make_tuple4(env, res_term, ck_term, ik_term, ak_term);
{% else %}
        ERL_NIF_TERM result;
{% if operation.name == 'topc' %}
        size_t length = 32, offset = 0;
{% elif operation.name in ('f1', 'f1_star') %}
        size_t length = options.mac_length, offset = 0;
{% elif operation.name in ('f5', 'f5_star') %}
        size_t length = 6, offset = 96;
{% else %}
        size_t length = options.{{ operation.member }}_length, offset = {{ {'res':0, 'ck':32, 'ik':64}[operation.member] }};
{% endif %}
        uint8_t *output = enif_make_new_binary(env, length, &result);
        if (output == NULL)
            return EXCP_ERROR(env, "Cannot allocate TUAK output");
        libdecaf_nif_tuak_extract(trap->state, offset, output, length);
        return result;
{% endif %}
    }
{% endfor %}
    return enif_make_badarg(env);
}

static ERL_NIF_TERM
libdecaf_nif_tuak_continue(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    libdecaf_nif_tuak_trap_t *trap;
    if (argc != 1 || !enif_get_resource(env, argv[0], libdecaf_nif_tuak_resource_type, (void **)&trap))
        return enif_make_badarg(env);
    if (!enif_is_current_process_alive(env))
        return enif_make_badarg(env);
    /* About 0.1 ms on the reference machine, even for UINT32_MAX iterations. */
    uint32_t count = trap->remaining < LIBDECAF_NIF_TUAK_PERMUTATIONS_PER_CALL ? trap->remaining : LIBDECAF_NIF_TUAK_PERMUTATIONS_PER_CALL;
    libdecaf_nif_tuak_iterate(trap->state, count);
    trap->remaining -= count;
    enif_consume_timeslice(env, (int)((count * 100 + LIBDECAF_NIF_TUAK_PERMUTATIONS_PER_CALL - 1) / LIBDECAF_NIF_TUAK_PERMUTATIONS_PER_CALL));
    if (trap->remaining != 0)
        return enif_schedule_nif(env, "libdecaf_nif_tuak_continue", ERL_NIF_NORMAL_JOB_BOUND,
                                libdecaf_nif_tuak_continue, 1, argv);
    ERL_NIF_TERM result = libdecaf_nif_tuak_finish(env, trap);
    decaf_bzero(trap, sizeof(*trap));
    return result;
}

{% for operation in ctx.tuak_operations %}
ERL_NIF_TERM
libdecaf_nif_tuak_{{ operation.name }}_{{ operation.arity }}(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    if (argc != {{ operation.arity }})
        return enif_make_badarg(env);
    ERL_NIF_TERM args[] = { {% for input in operation.inputs %}argv[{{ loop.index0 }}], {% endfor %}enif_make_new_map(env) };
    return libdecaf_nif_tuak_{{ operation.name }}_{{ operation.arity + 1 }}(env, {{ operation.arity + 1 }}, args);
}

ERL_NIF_TERM
libdecaf_nif_tuak_{{ operation.name }}_{{ operation.arity + 1 }}(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    if (argc != {{ operation.arity + 1 }})
        return enif_make_badarg(env);
{% for input in operation.inputs %}
    ErlNifBinary {{ input.c_name }};
    if (!enif_inspect_binary(env, argv[{{ loop.index0 }}], &{{ input.c_name }}) ||
        ({% for length in input.lengths %}{{ input.c_name }}.size != {{ length }}{{ ' && ' if not loop.last else '' }}{% endfor %}))
        return EXCP_BADARG(env, "{{ input.name }} must be a binary of {{ input.lengths | join(' or ') }} bytes");
{% endfor %}
    libdecaf_nif_tuak_options_t options = {
{% for option in ctx.tuak_options %}
        .{{ option.name }} = {{ ctx.schema.nif.tuak | attr('default_' + option.name) }},
{% endfor %}
    };
    const libdecaf_nif_tuak_option_t accepted[] = {
{% for name in operation.options %}
{% set option = ctx.tuak_options | selectattr('name', 'equalto', name) | first %}
        {ATOM({{ name }}), &options.{{ name }}, {{ 'libdecaf_nif_tuak_' + name + 's' if option.lengths else 'NULL' }}, {{ option.lengths | length }}},
{% endfor %}
    };
    if (!libdecaf_nif_tuak_options(env, argv[{{ operation.arity }}], accepted, sizeof(accepted) / sizeof(accepted[0])))
        return EXCP_BADARG(env, "TUAK {{ operation.name }} options must contain valid values for {{ operation.options | join(', ') }} only");
    libdecaf_nif_tuak_trap_t *trap = enif_alloc_resource(libdecaf_nif_tuak_resource_type, sizeof(*trap));
    if (trap == NULL)
        return EXCP_ERROR(env, "Cannot allocate TUAK evaluation");
    decaf_bzero(trap, sizeof(*trap));
    trap->options = options;
    trap->remaining = options.iterations;
    trap->operation = ATOM(tuak_{{ operation.name }});
{% if operation.name == 'topc' %}
    libdecaf_nif_tuak_prepare(trap->state, key.data, key.size, top.data, 0, NULL, NULL, NULL);
{% elif operation.name in ('f1', 'f1_star') %}
    libdecaf_nif_tuak_prepare(trap->state, key.data, key.size, topc.data,
        (uint8_t)(options.mac_length{{ ' | 0x80' if operation.name == 'f1_star' else '' }}), rand.data, sqn.data, amf.data);
{% elif operation.name == 'f5_star' %}
    libdecaf_nif_tuak_prepare(trap->state, key.data, key.size, topc.data, 0xC0, rand.data, NULL, NULL);
{% else %}
    uint8_t instance = (uint8_t)(0x40 | (options.res_length & 0x38) | ((options.ck_length >> 3) & 0x04) |
                                ((options.ik_length >> 4) & 0x02));
    libdecaf_nif_tuak_prepare(trap->state, key.data, key.size, topc.data, instance, rand.data, NULL, NULL);
{% endif %}
    ERL_NIF_TERM argument = enif_make_resource(env, trap);
    enif_release_resource(trap);
    return libdecaf_nif_tuak_continue(env, 1, &argument);
}

{% endfor %}
