#include "xof.h"
#include <decaf/common.h>
#include "../parallel/operation.h"
{% for family in ctx.crypto_families if family.xof_algorithms %}
#include "../{{ family.header }}"
{% endfor %}

/* Atom tags identify algorithms exactly and remain stable across NIF upgrades. */
static const libdecaf_nif_xof_algorithm_t *
libdecaf_nif_xof_lookup(ErlNifEnv *env, ERL_NIF_TERM atom)
{
    (void)env;
{% for algorithm in ctx.crypto_algorithms() if algorithm.functions("xof", "init") %}
    if (atom == ATOM({{ algorithm.name }}))
        return &{{ algorithm.symbol }}_xof_algorithm;
{% endfor %}
    return NULL;
}

{% include 'c_src/nif/xof/lifecycle.c.inc' %}

/* Decode only this API's algorithm parameters. */
typedef struct {
    const libdecaf_nif_xof_algorithm_t *algorithm;
    const ERL_NIF_TERM *argv;
    ERL_NIF_TERM atom;
    int argc;
} libdecaf_nif_xof_parameters_t;

static bool
libdecaf_nif_xof_parameters(ErlNifEnv *env, ERL_NIF_TERM term, libdecaf_nif_xof_parameters_t *parameters)
{
    const ERL_NIF_TERM *items;
    int arity;
    if (!enif_get_tuple(env, term, &arity, &items)) {
        parameters->atom = term;
        items = &parameters->atom;
        arity = 1;
    }
    if (arity < 1 || arity > {{ ctx.crypto_max_arity }})
        return false;
    parameters->algorithm = libdecaf_nif_xof_lookup(env, items[0]);
    parameters->argc = arity - 1;
    parameters->argv = items + 1;
    return parameters->algorithm != NULL;
}

ERL_NIF_TERM
libdecaf_nif_xof_init_1(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    libdecaf_nif_xof_parameters_t parameters;
    if (argc != 1 || !libdecaf_nif_xof_parameters(env, argv[0], &parameters))
        return EXCP_BADARG(env, "Invalid XOF initialization parameters");
    return parameters.algorithm->init(env, parameters.argc, parameters.argv);
}

ERL_NIF_TERM
libdecaf_nif_xof_3(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    libdecaf_nif_xof_parameters_t parameters;
    if (argc != 3 || !libdecaf_nif_xof_parameters(env, argv[0], &parameters) ||
        parameters.argc + 2 > {{ ctx.crypto_max_arity }})
        return EXCP_BADARG(env, "Invalid XOF parameters");
    ERL_NIF_TERM args[{{ ctx.crypto_max_arity }}];
    args[0] = argv[1];
    args[1] = argv[2];
    for (int i = 0; i < parameters.argc; i++)
        args[i + 2] = parameters.argv[i];
    return parameters.algorithm->compute(env, parameters.argc + 2, args);
}

ERL_NIF_TERM
libdecaf_nif_xof_absorb_2(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    const libdecaf_nif_xof_algorithm_t *algorithm;
    libdecaf_nif_xof_state_t *old;
    if (argc != 2 || (old = libdecaf_nif_xof_get(env, argv[0], &algorithm)) == NULL)
        return EXCP_BADARG(env, "Expected an XOF state");
    if (old->squeezing)
        return EXCP_BADARG(env, "Cannot absorb input after squeezing has begun");
    libdecaf_nif_xof_state_t *state = libdecaf_nif_xof_clone(env, old, algorithm);
    if (state == NULL)
        return EXCP_ERROR(env, "Can't allocate XOF context");
    return libdecaf_nif_xof_run(env, state, enif_make_list(env, 0), argv[1],
        algorithm->element != NULL ? LIBDECAF_NIF_XOF_INPUT_ELEMENT : LIBDECAF_NIF_XOF_INPUT_DATA, false, false, 0);
}

ERL_NIF_TERM
libdecaf_nif_xof_squeeze_2(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    const libdecaf_nif_xof_algorithm_t *algorithm;
    libdecaf_nif_xof_state_t *old;
    if (argc != 2 || (old = libdecaf_nif_xof_get(env, argv[0], &algorithm)) == NULL)
        return EXCP_BADARG(env, "Expected an XOF state");
    size_t length;
    if (!libdecaf_nif_xof_length(env, argv[1], algorithm, &length))
        return EXCP_BADARG(env, "Length must be a non-negative byte count");
    libdecaf_nif_xof_state_t *state = libdecaf_nif_xof_clone(env, old, algorithm);
    if (state == NULL)
        return EXCP_ERROR(env, "Can't allocate XOF context");
    return libdecaf_nif_xof_run(env, state, enif_make_list(env, 0), enif_make_list(env, 0),
        LIBDECAF_NIF_XOF_INPUT_NONE, true, true, length);
}
