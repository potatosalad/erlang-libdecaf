/* clang-format off */ //-
{% from 'c_src/nif/xof/lifecycle.c.inc' import lifecycle %}
{% from 'c_src/nif/xof/entry_points.c.inc' import entry_points %}
{% set group = 'kt' %}
{% set p = 'libdecaf_nif_xof_kt' %}
{% set profile = ctx.schema.nif.xof.values() | selectattr('group', 'equalto', group) | first %}
#include <keccak_internal.h>
#include "xof_kt.h"

#include <assert.h>

typedef struct libdecaf_nif_xof_kt_ctx_s {
    decaf_keccak_sponge_s root;
    decaf_keccak_sponge_s leaf;
    size_t rate;
    size_t chaining_len;
    size_t root_len;
    size_t leaf_len;
    size_t chaining_count;
    size_t customization_len;
    bool tree;
    bool finalized;
} libdecaf_nif_xof_kt_ctx_t;


/* RFC 9861 length_encode differs from SP 800-185 right_encode at zero. */
static size_t
libdecaf_nif_xof_kt_length_encode(size_t value, uint8_t *encoded)
{
    size_t bytes = 0;
    for (size_t remaining = value; remaining != 0; remaining >>= 8) {
        bytes++;
    }
    for (size_t i = 0; i < bytes; i++) {
        encoded[bytes - i - 1] = (uint8_t)(value >> (8 * i));
    }
    encoded[bytes] = (uint8_t)bytes;
    return bytes + 1;
}

static void
libdecaf_nif_xof_kt_init(libdecaf_nif_xof_kt_ctx_t *ctx, size_t rate)
{
    decaf_kparams_s params = {0, 'A', (uint8_t)rate, 12, 0x07, 0x80, 0xFF, 0xFF};
    decaf_bzero(ctx, sizeof(*ctx));
    ctx->rate = rate;
    ctx->chaining_len = 200 - rate;
    decaf_sha3_init(&ctx->root, &params);
    params.pad = 0x0B;
    decaf_sha3_init(&ctx->leaf, &params);
}

{% for name, algorithm in ctx.schema.nif.xof | dictsort %}
{% if algorithm.kt_rate is not none %}
static void
{{ algorithm.init }}(libdecaf_nif_xof_kt_ctx_t *ctx)
{
    libdecaf_nif_xof_kt_init(ctx, {{ algorithm.kt_rate }});
}
{% endif %}
{% endfor %}

static void
libdecaf_nif_xof_kt_emit_leaf(libdecaf_nif_xof_kt_ctx_t *ctx)
{
    uint8_t chaining_value[64];
    decaf_sha3_output(&ctx->leaf, chaining_value, ctx->chaining_len);
    decaf_sha3_update(&ctx->root, chaining_value, ctx->chaining_len);
    decaf_bzero(chaining_value, sizeof(chaining_value));
    decaf_sha3_reset(&ctx->leaf);
    ctx->leaf_len = 0;
    ctx->chaining_count++;
}

static void
libdecaf_nif_xof_kt_update(libdecaf_nif_xof_kt_ctx_t *ctx, const uint8_t *input, size_t input_len)
{
    assert(!ctx->finalized);
    while (input_len != 0) {
        if (!ctx->tree && ctx->root_len == 8192) {
            static const uint8_t divider[8] = {0x03, 0, 0, 0, 0, 0, 0, 0};
            decaf_sha3_update(&ctx->root, divider, sizeof(divider));
            ctx->root.params->pad = 0x06;
            ctx->tree = true;
        }
        size_t remaining = 8192 - (ctx->tree ? ctx->leaf_len : ctx->root_len);
        size_t take = input_len < remaining ? input_len : remaining;
        if (ctx->tree) {
            decaf_sha3_update(&ctx->leaf, input, take);
            ctx->leaf_len += take;
            if (ctx->leaf_len == 8192) {
                libdecaf_nif_xof_kt_emit_leaf(ctx);
            }
        } else {
            decaf_sha3_update(&ctx->root, input, take);
            ctx->root_len += take;
        }
        input += take;
        input_len -= take;
    }
}

static void
libdecaf_nif_xof_kt_output(libdecaf_nif_xof_kt_ctx_t *ctx, uint8_t *output, size_t output_len)
{
    if (!ctx->finalized) {
        uint8_t encoded[sizeof(size_t) + 1];
        size_t encoded_len = libdecaf_nif_xof_kt_length_encode(ctx->customization_len, encoded);
        libdecaf_nif_xof_kt_update(ctx, encoded, encoded_len);
        if (ctx->tree) {
            if (ctx->leaf_len != 0) {
                libdecaf_nif_xof_kt_emit_leaf(ctx);
            }
            encoded_len = libdecaf_nif_xof_kt_length_encode(ctx->chaining_count, encoded);
            decaf_sha3_update(&ctx->root, encoded, encoded_len);
            static const uint8_t trailer[2] = {0xFF, 0xFF};
            decaf_sha3_update(&ctx->root, trailer, sizeof(trailer));
        }
        ctx->finalized = true;
    }
    decaf_sha3_output(&ctx->root, output, output_len);
}

static void
libdecaf_nif_xof_kt_destroy(libdecaf_nif_xof_kt_ctx_t *ctx)
{
    decaf_bzero(ctx, sizeof(*ctx));
}

static bool
{{ p }}_select(ErlNifEnv *env, ERL_NIF_TERM algorithm, {{ p }}_ctx_t *state)
{
{% for name, profile in ctx.schema.nif.xof | dictsort if profile.group == group %}
    if (enif_is_identical(algorithm, ATOM({{ name }}))) {
        {{ profile.init }}(state);
        return true;
    }
{% endfor %}
    return false;
}

{{ lifecycle(p, profile.update, profile.output, profile.destroy, streaming=true,
             absorbing="!state->finalized" if group == 'kt' else "state->params->flags == 'A'") }}
{{ entry_points(p, 'xof_' + group, profile.destroy) }}

/* KT customization is absorbed after the message, then length-encoded by output. */
ERL_NIF_TERM
{{ p }}_4(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    ErlNifBinary custom;
    if (argc != 4 || !enif_inspect_iolist_as_binary(env, argv[3], &custom)) {
        return EXCP_BADARG(env, "Customization must be iodata");
    }
    if (!enif_is_binary(env, argv[1]) && !enif_is_list(env, argv[1])) {
        return EXCP_BADARG(env, "Input must be iodata");
    }
    unsigned long output_len;
    if (!enif_get_ulong(env, argv[2], &output_len)) {
        return EXCP_BADARG(env, "OutputLen must be a non-negative integer");
    }
    {{ p }}_ctx_t state;
    if (!{{ p }}_select(env, argv[0], &state)) {
        return EXCP_BADARG(env, "Algorithm must be kt128 or kt256");
    }
    state.customization_len = custom.size;
    ERL_NIF_TERM input = enif_make_list2(env, argv[1], argv[3]);
    ERL_NIF_TERM result = {{ p }}_absorb(env, &state, input, {{ p }}_squeeze, output_len);
    {{ p }}_destroy(&state);
    return result;
}

static ERL_NIF_TERM
{{ p }}_customized_output(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[], {{ p }}_done_t done)
{
    {{ p }}_ctx_t *old_state;
    if (argc != 3 || !enif_get_resource(env, argv[0], {{ p }}_resource_type, (void **)&old_state)) {
        return EXCP_BADARG(env, "State must be a xof_kt resource");
    }
    if (old_state->finalized) {
        return EXCP_BADARG(env, "Customization must be supplied before squeezing begins");
    }
    unsigned long output_len;
    if (!enif_get_ulong(env, argv[1], &output_len)) {
        return EXCP_BADARG(env, "OutputLen must be a non-negative integer");
    }
    ErlNifBinary custom;
    if (!enif_inspect_iolist_as_binary(env, argv[2], &custom)) {
        return EXCP_BADARG(env, "Customization must be iodata");
    }
    {{ p }}_ctx_t state = *old_state;
    state.customization_len = custom.size;
    ERL_NIF_TERM result = {{ p }}_absorb(env, &state, argv[2], done, output_len);
    {{ p }}_destroy(&state);
    return result;
}

ERL_NIF_TERM
{{ p }}_final_3(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    return {{ p }}_customized_output(env, argc, argv, {{ p }}_squeeze);
}

ERL_NIF_TERM
{{ p }}_squeeze_3(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    return {{ p }}_customized_output(env, argc, argv, {{ p }}_squeeze_state);
}
/* clang-format on */ //-
