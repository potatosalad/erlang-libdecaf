{% from 'c_src/nif/xof/lifecycle.c.inc' import lifecycle %}
{% from 'c_src/nif/xof/entry_points.c.inc' import entry_points %}
{% set group = 'cshake' %}
{% set p = 'libdecaf_nif_xof_cshake' %}
{% set profile = ctx.schema.nif.xof.values() | selectattr('group', 'equalto', group) | first %}
#include <keccak_internal.h>
#include "xof_cshake.h"

typedef decaf_keccak_sponge_s {{ p }}_ctx_t;

/* SP 800-185 encodes lengths in bits, with the integer's byte count first. */
static size_t
libdecaf_nif_xof_cshake_left_encode(size_t value, uint8_t *encoded)
{
    size_t bytes = 1;
    for (size_t remaining = value; (remaining >>= 8) != 0; bytes++) {
    }
    encoded[0] = (uint8_t)bytes;
    for (size_t i = 0; i < bytes; i++) {
        encoded[bytes - i] = (uint8_t)(value >> (8 * i));
    }
    return bytes + 1;
}

/* Build bytepad(encode_string(N) || encode_string(S), rate) as iodata.
 * Return 1 on success, 0 for invalid input, or -1 on allocation failure.
 * The ordinary absorb/update paths handle yielding for large prefixes. */
static int
libdecaf_nif_xof_cshake_prefix(ErlNifEnv *env, size_t rate, ERL_NIF_TERM function_name,
                                   ERL_NIF_TERM customization, ERL_NIF_TERM *prefix, bool *customized)
{
    ErlNifBinary name, custom;
    if (!enif_inspect_iolist_as_binary(env, function_name, &name) ||
        !enif_inspect_iolist_as_binary(env, customization, &custom) ||
        name.size > SIZE_MAX / 8 || custom.size > SIZE_MAX / 8) {
        return 0;
    }
    *customized = name.size != 0 || custom.size != 0;
    if (!*customized) {
        *prefix = enif_make_list(env, 0);
        return 1;
    }
    uint8_t header[2 * (sizeof(size_t) + 1)], encoded_custom[sizeof(size_t) + 1];
    size_t header_len = libdecaf_nif_xof_cshake_left_encode(rate, header);
    header_len += libdecaf_nif_xof_cshake_left_encode(name.size * 8, header + header_len);
    size_t custom_len = libdecaf_nif_xof_cshake_left_encode(custom.size * 8, encoded_custom);
    size_t remainder = (header_len + name.size % rate + custom_len + custom.size % rate) % rate;
    size_t padding_len = (rate - remainder) % rate;
    ERL_NIF_TERM parts[5];
    uint8_t *data = enif_make_new_binary(env, header_len, &parts[0]);
    if (data == NULL) {
        return -1;
    }
    memcpy(data, header, header_len);
    parts[1] = function_name;
    data = enif_make_new_binary(env, custom_len, &parts[2]);
    if (data == NULL) {
        return -1;
    }
    memcpy(data, encoded_custom, custom_len);
    parts[3] = customization;
    data = enif_make_new_binary(env, padding_len, &parts[4]);
    if (padding_len != 0) {
        if (data == NULL) {
            return -1;
        }
        decaf_bzero(data, padding_len);
    }
    *prefix = enif_make_list_from_array(env, parts, 5);
    return 1;
}


static bool
{{ p }}_select(ErlNifEnv *env, ERL_NIF_TERM algorithm, {{ p }}_ctx_t *state)
{
{% for name, profile in ctx.schema.nif.xof | dictsort if profile.group == group %}
    if (enif_is_identical(algorithm, ATOM({{ name }}))) {
        {{ profile.init }}(state);
        return true;
    }
{% endfor %}
    return false;
}

{{ lifecycle(p, profile.update, profile.output, profile.destroy) }}
{{ entry_points(p, 'xof_' + group, profile.destroy) }}

/* Only cSHAKE builds SP 800-185 prefixes and selects the 0x04 domain. */
ERL_NIF_TERM
{{ p }}_init_3(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    {{ p }}_ctx_t state;
    if (argc != 3 || !{{ p }}_select(env, argv[0], &state)) {
        return EXCP_BADARG(env, "Algorithm must be cshake128 or cshake256");
    }
    ERL_NIF_TERM prefix;
    bool customized;
    int status = {{ p }}_prefix(env, state.params->rate, argv[1], argv[2], &prefix, &customized);
    if (status != 1) {
        decaf_sha3_destroy(&state);
        return status == 0 ? EXCP_BADARG(env, "FunctionName and Customization must be iodata") :
                             EXCP_ERROR(env, "Can't allocate cSHAKE prefix");
    }
    if (customized) {
        state.params->pad = 0x04;
    }
    ERL_NIF_TERM result = {{ p }}_absorb(env, &state, prefix, {{ p }}_make_state, 0);
    decaf_sha3_destroy(&state);
    return result;
}

ERL_NIF_TERM
{{ p }}_5(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    unsigned long output_len;
    if (argc != 5 || !enif_get_ulong(env, argv[2], &output_len)) {
        return EXCP_BADARG(env, "OutputLen must be a non-negative integer");
    }
    if (!enif_is_binary(env, argv[1]) && !enif_is_list(env, argv[1])) {
        return EXCP_BADARG(env, "Input must be iodata");
    }
    {{ p }}_ctx_t state;
    if (!{{ p }}_select(env, argv[0], &state)) {
        return EXCP_BADARG(env, "Algorithm must be cshake128 or cshake256");
    }
    ERL_NIF_TERM prefix;
    bool customized;
    int status = {{ p }}_prefix(env, state.params->rate, argv[3], argv[4], &prefix, &customized);
    if (status != 1) {
        decaf_sha3_destroy(&state);
        return status == 0 ? EXCP_BADARG(env, "FunctionName and Customization must be iodata") :
                             EXCP_ERROR(env, "Can't allocate cSHAKE prefix");
    }
    if (customized) {
        state.params->pad = 0x04;
    }
    ERL_NIF_TERM input = enif_make_list2(env, prefix, argv[1]);
    ERL_NIF_TERM result = {{ p }}_absorb(env, &state, input, {{ p }}_squeeze, output_len);
    decaf_sha3_destroy(&state);
    return result;
}
