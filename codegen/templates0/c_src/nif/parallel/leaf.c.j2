void
libdecaf_nif_parallel_leaf_hash(libdecaf_nif_parallel_leaf_t algorithm, const uint8_t *input, size_t length,
                                uint8_t *chaining)
{
    decaf_keccak_sponge_s leaf;
    if (algorithm.turbo) {
        libdecaf_nif_turboshake_init(&leaf, algorithm.rate, 0x0B);
        libdecaf_nif_turboshake_absorb(&leaf, input, length);
        libdecaf_nif_turboshake_squeeze(&leaf, chaining, 200 - algorithm.rate);
    } else {
        decaf_kparams_s params = {0, 'A', (uint8_t)algorithm.rate, 0, 0x1F, 0x80, 0xFF, 0xFF};
        decaf_sha3_init(&leaf, &params);
        decaf_sha3_update(&leaf, input, length);
        decaf_sha3_output(&leaf, chaining, 200 - algorithm.rate);
    }
    decaf_bzero(&leaf, sizeof(leaf));
}

