#include "leaf.h"
#include <keccak_internal.h>
#include <decaf/shake.h>

unsigned int
libdecaf_nif_parallel_leaf_width(void)
{
    return decaf_keccak_parallelism();
}

void
libdecaf_nif_parallel_leaf_hash(libdecaf_nif_parallel_leaf_t algorithm, const uint8_t *input, size_t length, uint8_t *chaining)
{
    decaf_kparams_s params = {0, 'A', (uint8_t)algorithm.rate, algorithm.turbo ? 12 : 0,
                            algorithm.turbo ? 0x0B : 0x1F, 0x80, 0xFF, 0xFF};
    decaf_sha3_hash(chaining, 200 - algorithm.rate, input, length, &params);
}

void
libdecaf_nif_parallel_leaf_hash_many(libdecaf_nif_parallel_leaf_t algorithm, const uint8_t *const *inputs, size_t length,
                                    uint8_t *const *chaining, unsigned int width)
{
    decaf_kparams_s params = {0, 'A', (uint8_t)algorithm.rate, algorithm.turbo ? 12 : 0,
                            algorithm.turbo ? 0x0B : 0x1F, 0x80, 0xFF, 0xFF};
    decaf_sha3_hash_parallel(chaining, 200 - algorithm.rate, inputs, length, width, &params);
}
