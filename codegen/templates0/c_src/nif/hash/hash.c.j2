#include "hash.h"
#include <decaf/common.h>
{% for family in ctx.crypto_families if family.hash_algorithms %}
#include "../{{ family.header }}"
{% endfor %}

/* Atom tags identify algorithms across NIF upgrades without retaining pointers
 * into a previous library generation. */
static const libdecaf_nif_hash_algorithm_t *const libdecaf_nif_hash_algorithms[] = {
{% for algorithm in ctx.crypto_algorithms() if algorithm.functions("hash", "init") %}
    &{{ algorithm.symbol }}_hash_algorithm,
{% endfor %}
};

static int
libdecaf_nif_hash_compare(const void *name, const void *entry)
{
    const libdecaf_nif_hash_algorithm_t *const *algorithm = entry;
    return strcmp(name, (*algorithm)->name);
}

static const libdecaf_nif_hash_algorithm_t *
libdecaf_nif_hash_lookup(ErlNifEnv *env, ERL_NIF_TERM atom)
{
    char name[{{ (ctx.crypto_algorithms() | map(attribute='name') | map('length') | max) + 1 }}];
    if (!enif_get_atom(env, atom, name, sizeof(name), ERL_NIF_LATIN1))
        return NULL;
    const libdecaf_nif_hash_algorithm_t *const *found = bsearch(name, libdecaf_nif_hash_algorithms,
        sizeof(libdecaf_nif_hash_algorithms) / sizeof(libdecaf_nif_hash_algorithms[0]),
        sizeof(libdecaf_nif_hash_algorithms[0]), libdecaf_nif_hash_compare);
    return found != NULL ? *found : NULL;
}

{% include 'c_src/nif/hash/lifecycle.c.inc' %}

/* Decode only this API's algorithm parameters. */
typedef struct {
    const libdecaf_nif_hash_algorithm_t *algorithm;
    const ERL_NIF_TERM *argv;
    ERL_NIF_TERM atom;
    int argc;
} libdecaf_nif_hash_parameters_t;

static bool
libdecaf_nif_hash_parameters(ErlNifEnv *env, ERL_NIF_TERM term, libdecaf_nif_hash_parameters_t *parameters)
{
    const ERL_NIF_TERM *items;
    int arity;
    if (!enif_get_tuple(env, term, &arity, &items)) {
        parameters->atom = term;
        items = &parameters->atom;
        arity = 1;
    }
    if (arity < 1 || arity > {{ ctx.crypto_max_arity }})
        return false;
    parameters->algorithm = libdecaf_nif_hash_lookup(env, items[0]);
    parameters->argc = arity - 1;
    parameters->argv = items + 1;
    return parameters->algorithm != NULL;
}

ERL_NIF_TERM
libdecaf_nif_hash_init_1(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    libdecaf_nif_hash_parameters_t parameters;
    if (argc != 1 || !libdecaf_nif_hash_parameters(env, argv[0], &parameters))
        return EXCP_BADARG(env, "Invalid Hash initialization parameters");
    return parameters.algorithm->init(env, parameters.argc, parameters.argv);
}

ERL_NIF_TERM
libdecaf_nif_hash_2(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    libdecaf_nif_hash_parameters_t parameters;
    if (argc != 2 || !libdecaf_nif_hash_parameters(env, argv[0], &parameters))
        return EXCP_BADARG(env, "Invalid Hash parameters");
    ERL_NIF_TERM args[{{ ctx.crypto_max_arity }}];
    args[0] = argv[1];
    for (int i = 0; i < parameters.argc; i++)
        args[i + 1] = parameters.argv[i];
    return parameters.algorithm->compute(env, parameters.argc + 1, args);
}

ERL_NIF_TERM
libdecaf_nif_hash_update_2(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    const libdecaf_nif_hash_algorithm_t *algorithm;
    libdecaf_nif_hash_state_t *old;
    if (argc != 2 || (old = libdecaf_nif_hash_get(env, argv[0], &algorithm)) == NULL)
        return EXCP_BADARG(env, "Expected a Hash state");
    libdecaf_nif_hash_state_t *state = libdecaf_nif_hash_clone(env, old, algorithm);
    if (state == NULL)
        return EXCP_ERROR(env, "Can't allocate Hash context");
    return libdecaf_nif_hash_run(env, state, enif_make_list(env, 0), argv[1],
        algorithm->element != NULL ? LIBDECAF_NIF_HASH_INPUT_ELEMENT : LIBDECAF_NIF_HASH_INPUT_DATA, false);
}

ERL_NIF_TERM
libdecaf_nif_hash_final_1(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    const libdecaf_nif_hash_algorithm_t *algorithm;
    libdecaf_nif_hash_state_t *old;
    if (argc != 1 || (old = libdecaf_nif_hash_get(env, argv[0], &algorithm)) == NULL)
        return EXCP_BADARG(env, "Expected a Hash state");
    libdecaf_nif_hash_state_t *state = libdecaf_nif_hash_clone(env, old, algorithm);
    if (state == NULL)
        return EXCP_ERROR(env, "Can't allocate Hash context");
    return libdecaf_nif_hash_run(env, state, enif_make_list(env, 0), enif_make_list(env, 0), LIBDECAF_NIF_HASH_INPUT_NONE, true);
}
/* clang-format on */ //-
