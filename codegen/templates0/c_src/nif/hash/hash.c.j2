/* clang-format off */ //-
#include "hash.h"
{% for f in ctx.crypto_families %}
#include "../{{ f.header }}"
{% endfor %}

/* Components own resources and continuations. These entry points only route
 * an opaque resource to its owner, or expand a parameter tuple for init. */
{% for mode, operations in [('hash', ['update', 'final']), ('xof', ['absorb', 'squeeze'])] %}
{% for operation in operations %}
ERL_NIF_TERM
libdecaf_nif_{{ mode }}_{{ operation }}_{{ 1 if operation == 'final' else 2 }}(
    ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    if (argc != {{ 1 if operation == 'final' else 2 }})
        return enif_make_badarg(env);
{% for f in ctx.crypto_families if mode == 'hash' or f.xof_algorithms %}
    if ({{ f.prefix }}_accepts(env, argv[0], {{ 'true' if mode == 'hash' else 'false' }}))
        return {{ f.prefix }}_{{ mode }}_{{ operation }}(env, argc, argv);
{% endfor %}
    return EXCP_BADARG(env, "Expected a {{ mode }} state");
}
{% endfor %}
ERL_NIF_TERM
libdecaf_nif_{{ mode }}_init_1(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    if (argc != 1)
        return enif_make_badarg(env);
    int arity;
    const ERL_NIF_TERM *parameters;
    ERL_NIF_TERM atom_args[] = {argv[0]};
    if (!enif_get_tuple(env, argv[0], &arity, &parameters)) {
        arity = 1;
        parameters = atom_args;
    }
    if (arity < 1)
        return EXCP_BADARG(env, "Initialization parameters must contain an algorithm");
{% for f in ctx.crypto_families %}
{% for fun in f.functions(mode) if fun.operation == 'init' %}
    if (arity == {{ fun.arity }} && (
{% for algorithm in fun.algorithms %}
        enif_is_identical(parameters[0], ATOM({{ algorithm }})){{ ' ||' if not loop.last else '' }}
{% endfor %}
    ))
        return {{ fun.c_name }}(env, arity, parameters);
{% endfor %}
{% endfor %}
    return EXCP_BADARG(env, "Invalid {{ mode }} initialization parameters");
}
{% endfor %}
/* clang-format on */ //-
