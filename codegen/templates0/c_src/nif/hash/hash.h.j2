/* clang-format off */ //-
#ifndef LIBDECAF_NIF_HASH_H
#define LIBDECAF_NIF_HASH_H

#include "../libdecaf_nif.h"
#include <stdbool.h>
#include <stddef.h>

#ifdef __cplusplus
extern "C" {
#endif

typedef ERL_NIF_TERM (*libdecaf_nif_hash_entry_t)(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[]);

typedef struct {
    const char *name;
    size_t context_size, context_alignment, default_output_len, max_output_len;
    bool length_bound;
    void (*clone)(void *destination, const void *source);
    void (*destroy)(void *context);
    void (*update)(void *context, const uint8_t *input, size_t length);
    void (*output)(void *context, uint8_t *output, size_t length);
    bool (*finish)(void *context, size_t output_len);
    bool (*valid)(const void *context);
    size_t (*input_cost)(const void *context);
    void (*element)(void *context, size_t length);
    void (*suffix)(const void *context, const uint8_t **data, size_t *length);
    libdecaf_nif_hash_entry_t init, compute;
} libdecaf_nif_hash_algorithm_t;

typedef struct libdecaf_nif_hash_state_s libdecaf_nif_hash_state_t;

typedef enum {
    LIBDECAF_NIF_HASH_INPUT_NONE,
    LIBDECAF_NIF_HASH_INPUT_DATA,
    LIBDECAF_NIF_HASH_INPUT_ELEMENT,
    LIBDECAF_NIF_HASH_INPUT_TUPLE
} libdecaf_nif_hash_input_t;

extern int libdecaf_nif_hash_load(ErlNifEnv *env);
extern libdecaf_nif_hash_state_t *libdecaf_nif_hash_alloc(ErlNifEnv *env, const libdecaf_nif_hash_algorithm_t *algorithm, size_t length);
extern void *libdecaf_nif_hash_context(libdecaf_nif_hash_state_t *state);
extern bool libdecaf_nif_hash_length(ErlNifEnv *env, ERL_NIF_TERM term, const libdecaf_nif_hash_algorithm_t *algorithm, size_t *length);
/* Takes ownership of the private state on every path. */
extern ERL_NIF_TERM libdecaf_nif_hash_run(ErlNifEnv *env, libdecaf_nif_hash_state_t *state, ERL_NIF_TERM prefix, ERL_NIF_TERM input,
                                          libdecaf_nif_hash_input_t kind, bool output);
{% for fun in ctx.crypto_functions if not fun.algorithms and fun.family == "hash" %}
extern ERL_NIF_TERM {{ fun.c_name }}(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[]);
{% endfor %}

#ifdef __cplusplus
}
#endif

#endif
/* clang-format on */ //-
