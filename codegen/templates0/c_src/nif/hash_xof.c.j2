typedef struct libdecaf_nif_hash_xof_absorb_trap_s libdecaf_nif_hash_xof_absorb_trap_t;
static void libdecaf_nif_hash_xof_absorb_trap_dtor(ErlNifEnv *caller_env, void *obj);

struct libdecaf_nif_hash_xof_absorb_trap_s {
    libdecaf_nif_trap_t super;
    libdecaf_nif_hash_xof_t *xof;
    libdecaf_nif_hash_xof_ctx_t *ctx;
    ErlNifBinary input_bin;
    size_t input_off;
    size_t output_len;
};

void
libdecaf_nif_hash_xof_absorb_trap_dtor(ErlNifEnv *caller_env, void *obj)
{
    libdecaf_nif_hash_xof_absorb_trap_t *trap = (void *)obj;
    if (trap != NULL && trap->ctx != NULL) {
        XNIF_TRACE_F("libdecaf_nif_hash_xof_absorb_trap_dtor:%s:%d\n", __FILE__, __LINE__);
        (void)trap->xof->destroy((void *)trap->ctx);
        (void)enif_free((void *)trap->ctx);
        trap->ctx = NULL;
    }
    return;
}

