{
    if (argc != 2) {
        return EXCP_BADARG(env, "Invalid argument count");
    }
    void *state;
{% for function in ctx.xof_functions if function.operation == 'update' and function.arity == 2 %}
    if (enif_get_resource(env, argv[0], libdecaf_nif_{{ function.name.removesuffix('_' + function.operation) }}_resource_type, &state)) {
        return {{ function.c_name }}(env, argc, argv);
    }
{% endfor %}
    return EXCP_BADARG(env, "Invalid XOF state for this function arity");
}

