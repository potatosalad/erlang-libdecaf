#include "hash_xof.h"

/* Compatibility dispatch only. Each family owns validation, state, and trapping. */
int
libdecaf_nif_hash_xof_load(ErlNifEnv *env)
{
{% for group in ctx.xof_groups %}
    if (libdecaf_nif_{{ group.name }}_load(env) != 0) {
        return -1;
    }
{% endfor %}
    return 0;
}

ERL_NIF_TERM
libdecaf_nif_hash_xof_3(ErlNifEnv *env, int argc, const ERL_NIF_TERM argv[])
{
    if (argc != 3) {
        return EXCP_BADARG(env, "Invalid argument count");
    }
{% for function in ctx.xof_functions if function.operation == 'once' and function.arity == 3 %}
    if ({% for name in function.algorithms %}enif_is_identical(argv[0], ATOM({{ name }})){% if not loop.last %} || {% endif %}{% endfor %}) {
        return {{ function.c_name }}(env, argc, argv);
    }
{% endfor %}
    return EXCP_BADARG(env, "Unsupported XOF algorithm for this function arity");
}

