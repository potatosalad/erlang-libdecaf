%%% % @format
-module(libdecaf_nif).
-moduledoc """
Low-level native bindings for libdecaf cryptographic operations.

This module exposes Ed25519/Ed448 signatures, X25519/X448 key agreement,
Ristretto255/Decaf448 groups, SHA-2/SHA-3, legacy Keccak, SHAKE, cSHAKE,
Keccak XOFs, TurboSHAKE, KangarooTwelve, KMAC, and the sponge PRNG.
For convenience APIs, see `libdecaf_curve25519`, `libdecaf_curve448`,
`libdecaf_eddsa`, `libdecaf_ristretto255`, `libdecaf_decaf448`,
`libdecaf_sha2`, `libdecaf_sha3`, and `libdecaf_spongerng`.

Signing and key-agreement inputs use the fixed-size binary encodings documented
by the types below. Hash, XOF, and sponge-PRNG input accepts iodata. Ed25519's
`no_context` selects pure Ed25519; context binaries select its context/prehash
variants. Ed448 always takes a context binary of at most 255 bytes.

Hash, XOF, keypair, and precomputation resources are immutable and can be
shared between processes. Operations return new hash/XOF/PRNG states; retain
those returned states to advance an input or output stream. Keep secret keys
and PRNG states private. KMAC resources contain keyed sponge contexts and must
also be kept private. KMAC tag lengths are measured in bytes and are included
in the computation; requesting a shorter tag is different from truncation.

XOF `absorb` operations return new absorbing states. `squeeze` returns
`{NextState, Output}` and advances the output cursor in `NextState`.
Further absorption into a squeezing state raises an argument error, including
after a zero-byte squeeze. `update` and `final` remain snapshot convenience APIs.

Group operations accept canonical encodings, including identity points and zero
scalars. Validation functions return `false` for invalid terms. Arithmetic with
invalid encodings raises `badarg`; scalar inversion returns `error` for zero.
Key agreement returns `error` when the upstream operation rejects the input.

The native library loads automatically with this module. NIF loading failure
prevents the module from loading. These generated bindings require OTP 27 or
later for native Markdown documentation attributes.
""".
-moduledoc #{author => ["Andrew Bennett <potatosaladx@gmail.com>"]}.
-moduledoc #{created => "2018-11-27", modified => "2026-10-22"}.
-moduledoc #{copyright => "Andrew Bennett"}.
-compile(warn_missing_spec_all).

-on_load(init/0).

%% Error if the crypto NIFs are not loaded.
-define(nif_stub, nif_stub_error(?LINE)).

%% NIF API
-export([
~J{ for function in ctx.nif.functions }.
    ~J< function.name >./~J< function.arity >.~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).

-nifs([
~J{ for function in ctx.nif.functions }.
    ~J< function.name >./~J< function.arity >.~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).

%% Internal API
-export([
    init/0
]).

%%% Types

~J{ for name, definition, doc in ctx.types }.
-doc """
~J< doc >.
""".
-~J< 'opaque' if name in ctx.opaque_type_names else 'type' >. ~J< name >.() :: ~J< definition >..

~J{ endfor }.

-export_type([
~J{ for name, definition, doc in ctx.types }.
    ~J< name >./0~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).

%%%=============================================================================
%%% NIF API functions
%%%=============================================================================

~J{ for function in ctx.nif.functions }.
-doc """
~J< function.doc | wordwrap(110, break_long_words=false) >.
""".
-doc #{group => "~J< function.group >."}.
-spec ~J< function.spec >..
~J< function.name >.(~J< function.parameters >.) ->
    ?nif_stub.

~J{ endfor }.
%%%-----------------------------------------------------------------------------
%%% Internal functions
%%%-----------------------------------------------------------------------------

-doc false.
-spec init() -> Result when Result :: ok | {error, {atom(), string()}}.
init() ->
    SoName = filename:join(libdecaf:priv_dir(), ?MODULE_STRING),
    erlang:load_nif(SoName, 0).

-doc false.
-spec nif_stub_error(Line) -> Result when Line :: pos_integer(), Result :: dynamic().
nif_stub_error(Line) ->
    erlang:nif_error({nif_not_loaded, module, ?MODULE, line, Line}).
