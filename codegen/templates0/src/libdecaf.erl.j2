%%% Records

~J{ for name in hash_algorithms }.
-record(hash_state_~J< name >., {
    ctx :: libdecaf_nif:hash_state()
}).
~J{ endfor }.
~J{ for name in xof_algorithms }.
-record(hash_xof_state_~J< name >., {
    ctx :: libdecaf_nif:xof_state()
}).
~J{ endfor }.

%%% Types

-doc """
Supported fixed-output hash algorithms.
""".
-type hash_algorithm() ::
~J{ for name in hash_algorithms }.
    ~J< '| ' if not loop.first else '' >.~J< name >.~J< '.' if loop.last else '' >.
~J{ endfor }.

-doc """
An immutable hash state. Pass the returned state to subsequent updates.
The same state can be reused to hash different suffixes or finalized more than once.
""".
-opaque hash_state() ::
~J{ for name in hash_algorithms }.
    ~J< '| ' if not loop.first else '' >.hash_state_~J< name >.()~J< '.' if loop.last else '' >.
~J{ endfor }.

~J{ for name in hash_algorithms }.
-doc """
An immutable `~J< name >.` hash state.
""".
-opaque hash_state_~J< name >.() :: #hash_state_~J< name >.{}.

~J{ endfor }.
-doc """
Supported extendable-output hash algorithms.
""".
-type hash_xof_algorithm() ::
~J{ for name in xof_algorithms }.
    ~J< '| ' if not loop.first else '' >.~J< name >.~J< '.' if loop.last else '' >.
~J{ endfor }.

-doc """
An immutable extendable-output hash state.
Updates return new states; finalization leaves the input state reusable.
""".
-opaque hash_xof_state() ::
~J{ for name in xof_algorithms }.
    ~J< '| ' if not loop.first else '' >.hash_xof_state_~J< name >.()~J< '.' if loop.last else '' >.
~J{ endfor }.

~J{ for name in xof_algorithms }.
-doc """
An immutable `~J< name >.` extendable-output hash state.
""".
-opaque hash_xof_state_~J< name >.() :: #hash_xof_state_~J< name >.{}.

~J{ endfor }.
%%%=============================================================================
%%% Hash API functions
%%%=============================================================================

-doc """
Hash iodata and return the algorithm's full digest.

```erlang
libdecaf:hash(sha3_256, <<"abc">>).
```
""".
-doc #{group => <<"Hash API">>}.
-spec hash(Type, Data) -> Digest when
    Type :: hash_algorithm(), Data :: iodata(), Digest :: binary().
hash(Type, Data) ->
    hash(Type, Data, hash_size(Type)).

-doc """
Hash iodata and return the first `Length` bytes of the digest.
`Length` is in bytes and must be between zero and the full digest size.
""".
-doc #{group => <<"Hash API">>}.
-spec hash(Type, Data, Length) -> Digest when
    Type :: hash_algorithm(), Data :: iodata(), Length :: non_neg_integer(), Digest :: binary().
~J{ for name in hash_algorithms }.
hash(~J< name >., Data, Length) ->
    libdecaf_nif:~J< name >._hash(Data, Length);
~J{ endfor }.
hash(Type, Data, Length) ->
    erlang:error(badarg, [Type, Data, Length]).

-doc """
Return the full digest of an incremental hash state.
The state remains reusable after finalization.
""".
-doc #{group => <<"Hash API">>}.
-spec hash_final(State) -> Digest when State :: hash_state(), Digest :: binary().
~J{ for name in hash_algorithms }.
hash_final(#hash_state_~J< name >.{} = State) ->
    hash_final(State, ~J< (name.rsplit('_', 1)[1] | int) // 8 >.);
~J{ endfor }.
hash_final(State) ->
    erlang:error(badarg, [State]).

-doc """
Return the first `Length` bytes of an incremental hash's digest.
`Length` is in bytes and must be between zero and the full digest size.
The state remains reusable after finalization.
""".
-doc #{group => <<"Hash API">>}.
-spec hash_final(State, Length) -> Digest when
    State :: hash_state(), Length :: non_neg_integer(), Digest :: binary().
~J{ for name in hash_algorithms }.
hash_final(#hash_state_~J< name >.{ctx = Context}, Length) ->
    libdecaf_nif:~J< name >._hash_final(Context, Length);
~J{ endfor }.
hash_final(State, Length) ->
    erlang:error(badarg, [State, Length]).

-doc """
Initialize an incremental hash.

```erlang
S0 = libdecaf:hash_init(sha3_256),
S1 = libdecaf:hash_update(S0, <<"a">>),
S2 = libdecaf:hash_update(S1, [<<"b">>, <<"c">>]),
Digest = libdecaf:hash_final(S2).
```
""".
-doc #{group => <<"Hash API">>}.
-spec hash_init(Type) -> State when Type :: hash_algorithm(), State :: hash_state().
~J{ for name in hash_algorithms }.
hash_init(~J< name >.) ->
    #hash_state_~J< name >.{ctx = libdecaf_nif:~J< name >._hash_init()};
~J{ endfor }.
hash_init(Type) ->
    erlang:error(badarg, [Type]).

-doc """
Absorb iodata and return a new hash state.
The original state remains reusable; continue hashing with the returned state.
""".
-doc #{group => <<"Hash API">>}.
-spec hash_update(State, Data) -> NewState when
    State :: hash_state(), Data :: iodata(), NewState :: hash_state().
~J{ for name in hash_algorithms }.
hash_update(#hash_state_~J< name >.{ctx = Context} = State, Data) ->
    State#hash_state_~J< name >.{ctx = libdecaf_nif:~J< name >._hash_update(Context, Data)};
~J{ endfor }.
hash_update(State, Data) ->
    erlang:error(badarg, [State, Data]).

%%%=============================================================================
%%% Hash XOF API functions
%%%=============================================================================

-doc """
Hash iodata with an extendable-output function and return `Length` bytes.
The output length may be any nonnegative number of bytes.

```erlang
libdecaf:hash_xof(shake256, <<"abc">>, 64).
```
""".
-doc #{group => <<"Hash XOF API">>}.
-spec hash_xof(Type, Data, Length) -> Output when
    Type :: hash_xof_algorithm(), Data :: iodata(), Length :: non_neg_integer(), Output :: binary().
~J{ for name in xof_algorithms }.
hash_xof(~J< name >., Data, Length) ->
    libdecaf_nif:~J< name >._xof(Data, Length);
~J{ endfor }.
hash_xof(Type, Data, Length) ->
    erlang:error(badarg, [Type, Data, Length]).

-doc """
Finalize an extendable-output hash state and return `Length` bytes.
The input state remains reusable. Repeated finalization starts at the same
position; request a larger length to obtain a longer output prefix.
""".
-doc #{group => <<"Hash XOF API">>}.
-spec hash_xof_final(State, Length) -> Output when
    State :: hash_xof_state(), Length :: non_neg_integer(), Output :: binary().
~J{ for name in xof_algorithms }.
hash_xof_final(#hash_xof_state_~J< name >.{ctx = Context}, Length) ->
    {_NewContext, Output} = libdecaf_nif:~J< name >._xof_output(Context, Length),
    Output;
~J{ endfor }.
hash_xof_final(State, Length) ->
    erlang:error(badarg, [State, Length]).

-doc """
Initialize an incremental extendable-output hash.

```erlang
S0 = libdecaf:hash_xof_init(shake256),
S1 = libdecaf:hash_xof_update(S0, <<"abc">>),
Output = libdecaf:hash_xof_final(S1, 64).
```
""".
-doc #{group => <<"Hash XOF API">>}.
-spec hash_xof_init(Type) -> State when Type :: hash_xof_algorithm(), State :: hash_xof_state().
~J{ for name in xof_algorithms }.
hash_xof_init(~J< name >.) ->
    #hash_xof_state_~J< name >.{ctx = libdecaf_nif:~J< name >._xof_init()};
~J{ endfor }.
hash_xof_init(Type) ->
    erlang:error(badarg, [Type]).

-doc """
Absorb iodata and return a new extendable-output hash state.
The original state remains reusable; continue with the returned state.
""".
-doc #{group => <<"Hash XOF API">>}.
-spec hash_xof_update(State, Data) -> NewState when
    State :: hash_xof_state(), Data :: iodata(), NewState :: hash_xof_state().
~J{ for name in xof_algorithms }.
hash_xof_update(#hash_xof_state_~J< name >.{ctx = Context} = State, Data) ->
    State#hash_xof_state_~J< name >.{ctx = libdecaf_nif:~J< name >._xof_update(Context, Data)};
~J{ endfor }.
hash_xof_update(State, Data) ->
    erlang:error(badarg, [State, Data]).

