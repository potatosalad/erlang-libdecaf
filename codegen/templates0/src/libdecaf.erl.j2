~J{ endfor }.
]).
~J{ endfor }.
~J{ for family in ('hash', 'xof') }.
%% ~J< 'Hash' if family == 'hash' else 'XOF' >. API
-export([
~J{ for function in ctx.public_crypto_functions if function.family == family }.
    ~J< function.name >./~J< function.arity >.~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).
~J{ endfor }.
%% Sponge PRNG API
-export([
    spongerng_random_bytes/1
]).
%%% Types
~J{ for type in ctx.public_types }.
-doc """
~J< type.doc >.
""".
-~J< 'opaque' if type.opaque else 'type' >. ~J< type.name >.() :: ~J< type.definition >..

~J{ endfor }.
-export_type([
~J{ for type in ctx.public_types }.
    ~J< type.name >./0~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).

~J{ include 'src/public_key_api.erl.inc' }.

~J{ for family in ('hash', 'xof') }.
%%%=============================================================================
%%% ~J< 'Hash' if family == 'hash' else 'XOF' >. API functions
%%%=============================================================================

~J{ for function in ctx.public_crypto_functions if function.family == family }.
-doc """
~J< ctx.crypto_doc(function) >.
""".
-doc #{group => <<"~J< function.group >.">>}.
-spec ~J< function.spec >..
~J< function.name >.(~J< function.arguments | map(attribute='name') | join(', ') >.) ->
~J{ if function.operation in ('parallel_update', 'parallel_absorb', 'parallel_once') }.
    parallel_wait(
        libdecaf_nif:~J< function.name >.(~J< function.arguments | map(attribute='name') | join(', ') >.),
        fun libdecaf_nif:parallel_~J< function.family >._continue/1,
~J{ if function.family == 'hash' }.
        fun(FinalState, _Length) -> libdecaf_nif:parallel_hash_final(FinalState) end
~J{ else }.
        fun(FinalState, Length) ->
            {_Next, Output} = libdecaf_nif:parallel_xof_squeeze(FinalState, Length),
            Output
        end
~J{ endif }.
    ).
~J{ else }.
    libdecaf_nif:~J< function.name >.(~J< function.arguments | map(attribute='name') | join(', ') >.).
~J{ endif }.

~J{ endfor }.
~J{ endfor }.

%%%=============================================================================
%%% Sponge PRNG API functions
%%%=============================================================================

-doc """
Generate `Length` cryptographically random bytes without managing a PRNG state.

The native implementation keeps a private SpongeRNG per dirty CPU scheduler
thread, seeded with 64 bytes of OS entropy. Before the next request after
generating 16 MiB or five minutes, it mixes in fresh entropy. It also reseeds
if the OS process ID changes. Calls advance private state automatically; there
is no state to retain, share, or accidentally reuse.

If native entropy is unavailable, `crypto:strong_rand_bytes/1` supplies a fresh
64-byte seed. Entropy-source failures raise an exception. Zero returns `<<>>`
without requesting entropy. `Length` must be a nonnegative integer that fits
the native length type and available memory. Generation uses dirty CPU
schedulers, and the libdecaf application does not need to be started.

```erlang
Token = libdecaf:spongerng_random_bytes(32),
32 = byte_size(Token),
<<>> = libdecaf:spongerng_random_bytes(0).
```
""".
-doc #{group => <<"Sponge PRNG API">>}.
-spec spongerng_random_bytes(Length) -> Output when Length :: non_neg_integer(), Output :: binary().
spongerng_random_bytes(Length) ->
    case libdecaf_nif:spongerng_random_bytes(Length) of
        need_seed ->
            libdecaf_nif:spongerng_random_bytes(Length, crypto:strong_rand_bytes(64));
        Output ->
            Output
    end.

~J{ include 'src/public_key_internal.erl.inc' }.

-spec parallel_wait(Result, Continue, Finalize) -> Value when
    Result :: dynamic(), Continue :: fun((dynamic()) -> dynamic()),
    Finalize :: fun((dynamic(), non_neg_integer()) -> dynamic()), Value :: dynamic().
parallel_wait({await, Reference, Operation}, Continue, Finalize) ->
    receive
        {libdecaf_parallel, Reference} -> ok
    after 50 -> ok
    end,
    parallel_wait(Continue(Operation), Continue, Finalize);
parallel_wait({done, Reference, State}, _Continue, _Finalize) ->
    parallel_flush(Reference),
    State;
parallel_wait({finalize, Reference, State, Length}, _Continue, Finalize) ->
    parallel_flush(Reference),
    Finalize(State, Length).

-spec parallel_flush(Reference) -> Result when Reference :: reference(), Result :: ok.
parallel_flush(Reference) ->
    receive
        {libdecaf_parallel, Reference} -> parallel_flush(Reference)
    after 0 -> ok
    end.
