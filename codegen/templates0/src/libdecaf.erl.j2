~J{ set hash_algorithms = ctx.schema.nif.hash | sort }.
~J{ set xof_algorithms = ctx.schema.nif.xof | sort }.
%%% % @format
-module(libdecaf).
-moduledoc """
Cryptographic primitives backed by libdecaf.

Provides Ed25519/Ed448 signatures, X25519/X448 key agreement,
Ristretto255/Decaf448 groups, SHA-2/SHA-3 and Keccak hashes, SHAKE, and the sponge PRNG.
""".
-moduledoc #{author => ["Andrew Bennett <potatosaladx@gmail.com>"]}.
-moduledoc #{created => "2016-02-06", modified => "2026-10-22"}.
-moduledoc #{copyright => "Andrew Bennett"}.

%% Hash API
-export([hash/2, hash/3, hash_final/1, hash_final/2, hash_init/1, hash_update/2]).
%% Hash XOF API
-export([hash_xof/3, hash_xof_final/2, hash_xof_init/1, hash_xof_update/2]).
-export_type([
    hash_algorithm/0,
    hash_state/0,
~J{ for name in hash_algorithms }.
    hash_state_~J< name >./0,
~J{ endfor }.
    hash_xof_algorithm/0,
    hash_xof_state/0,
~J{ for name in xof_algorithms }.
    hash_xof_state_~J< name >./0~J< ',' if not loop.last else '' >.
~J{ endfor }.
]).

