-doc false.
-spec hash_size(hash_algorithm()) -> pos_integer().
~J{ for name in hash_algorithms }.
hash_size(~J< name >.) -> ~J< (name.rsplit('_', 1)[1] | int) // 8 >.;
~J{ endfor }.
hash_size(Type) -> erlang:error(badarg, [Type]).

-doc false.
-spec priv_dir() -> file:filename_all().
priv_dir() ->
    case code:priv_dir(?MODULE) of
        {error, bad_name} ->
            case code:which(?MODULE) of
                Filename when is_list(Filename) ->
                    filename:join([filename:dirname(Filename), "../priv"]);
                _ ->
                    "../priv"
            end;
        Dir ->
            Dir
    end.

