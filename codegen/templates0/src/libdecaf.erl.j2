%%% Sponge PRNG API functions
%%%=============================================================================

-doc """
Generate `Length` cryptographically random bytes without managing a PRNG state.

The generator is seeded automatically from operating-system entropy and
reseeded periodically. If native entropy is unavailable, it uses
`crypto:strong_rand_bytes/1` to obtain seed bytes. An entropy-source failure
raises an exception. A zero-byte request returns `<<>>`.

For an explicitly seeded or deterministic stream, use `m:libdecaf_spongerng`.

```erlang
Token = libdecaf:strong_rand_bytes(32),
32 = byte_size(Token),
<<>> = libdecaf:strong_rand_bytes(0).
```
""".
-doc #{group => <<"Sponge PRNG API">>}.
-spec strong_rand_bytes(Length) -> Output when Length :: non_neg_integer(), Output :: binary().
strong_rand_bytes(Length) ->
    case libdecaf_nif:strong_rand_bytes(Length) of
        need_seed ->
            libdecaf_nif:strong_rand_bytes(Length, crypto:strong_rand_bytes(64));
        Output ->
            Output
    end.

