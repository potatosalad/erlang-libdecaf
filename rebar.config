%%% % @format
{erl_opts, [
    debug_info,
    warnings_as_errors
]}.
{deps, []}.

{pre_hooks, [
    {"(linux|darwin|solaris)", compile, "make -C c_src"},
    {"(freebsd)", compile, "gmake -C c_src"},
    {"(win32)", compile, "cd c_src && nmake /F Makefile.win"}
]}.
{post_hooks, [
    {"(linux|darwin|solaris)", clean, "make -C c_src clean distclean"},
    {"(freebsd)", clean, "gmake -C c_src clean distclean"},
    {"(win32)", compile, "cd c_src && nmake /F Makefile.win clean distclean"}
]}.

{hex, [{doc, ex_doc}]}.

%% Include the test suites and their OTP dependencies in success typing analysis.
{dialyzer, [
    {plt_extra_apps, [common_test, inets, public_key, ssl, asn1]}
]}.

%% A library's public exports are entry points for its callers.
{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.
