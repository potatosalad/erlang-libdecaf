%%% % @format
{application, libdecaf, [
    {description, "Cryptographic signatures, key agreement, hashes, XOFs, and random bytes for Erlang and Elixir"},
    {vsn, "3.0.0"},
    {id, "git"},
    {registered, [libdecaf_sup, libdecaf_parallel_routers_sup]},
    {mod, {libdecaf_app, []}},
    {env, [{parallel, true}, {parallel_absorb_rounds, 100}]},
    {applications, [
        kernel,
        stdlib,
        crypto
    ]},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"GitHub", "https://github.com/potatosalad/erlang-libdecaf"}]},
    {exclude_paths, ["c_src/env.mk", "c_deps/ed448goldilocks/.git"]},
    {exclude_patterns, ["\\.d$", "\\.pyc$", "(^|/)__pycache__(/|$)"]},
    {files, [
        "src",
        "include",
        "c_src",
        "c_deps/ed448goldilocks",
        "guides",
        "Makefile",
        "erlang.mk",
        "rebar.config",
        "rebar.lock",
        "ex_doc.config",
        "README.md",
        "CHANGELOG.md",
        "LICENSE.md"
    ]}
]}.
