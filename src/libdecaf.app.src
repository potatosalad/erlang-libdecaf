%%% % @format
{application, libdecaf, [
    {description,
        "libdecaf NIF for ECDH (X25519, X448), EdDSA (Ed25519, Ed25519ctx, Ed25519ph, Ed448, Ed448ph), curve25519, curve448, spongerng"},
    {vsn, "2.1.1"},
    {id, "git"},
    {registered, [libdecaf_sup, libdecaf_parallel_routers_sup]},
    {mod, {libdecaf_app, []}},
    {env, [{parallel, true}]},
    {applications, [
        kernel,
        stdlib,
        crypto
    ]},
    {modules, []},
    {licenses, ["MIT"]},
    {links, [{"Github", "https://github.com/potatosalad/erlang-libdecaf"}]},
    {include_paths, [
        "build.config",
        "erlang.mk",
        "Makefile",
        "c_deps/ed448goldilocks/"
    ]}
]}.
